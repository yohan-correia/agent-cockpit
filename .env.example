# Copie para .env. Node lê este arquivo; não precisa executar com source.
HOST=127.0.0.1
PORT=7879
# Obrigatório para bind fora de localhost; recomendado para qualquer acesso remoto.
COCKPIT_TOKEN=
# Vazio usa ~/projetos. Se definido, use caminho absoluto, sem ~ ou $HOME.
COCKPIT_PROJETOS_DIR=
# Socket vazio usa o tmux padrão. A sessão precisa existir antes de criar abas.
COCKPIT_TMUX_SOCKET=
COCKPIT_TMUX_SESSAO=main
# Binários são caminhos absolutos, sem argumentos e sem espaços.
# Descubra com: command -v claude; command -v codex
# COCKPIT_BIN_CLAUDE=/usr/local/bin/claude
# COCKPIT_BIN_CODEX=/usr/local/bin/codex
# Opt-in perigoso: 1 desativa aprovações e sandbox nas novas abas Codex.
COCKPIT_CODEX_SEM_APROVACAO=0
# Opcional: HTTPS direto. Configure os dois ou termine TLS no seu proxy.
# COCKPIT_TLS_CERT=/caminho/servidor.crt
# COCKPIT_TLS_KEY=/caminho/servidor.key
# Opcional: onde ficam os jobs do orquestrador. O chat funciona sem eles — pasta que não
# existe é o caso normal de quem não usa orquestrador nenhum, e a lista fica vazia sem erro.
# Vazio usa ~/.cockpit/jobs. Se definido, use caminho absoluto: `~` e `$HOME` não são
# expandidos aqui, e um caminho que não existe fica vazio SEM avisar.
# COCKPIT_JOBS_DIR=/home/voce/.cockpit/jobs
# Onde o orquestrador cria as worktrees dos jobs. Serve só para o medidor de uso saber
# que um `.jsonl` veio de um job, e não de uma aba comum. Mesmas regras de caminho.
# COCKPIT_WORKTREES_DIR=/home/voce/.cockpit/worktrees
# Depois de quantas horas parado um job travado sai da vista. Ele não some do disco: volta
# com `?arquivados=1` na rota. Padrão: 24.
# COCKPIT_HORAS_ARQUIVA=24

# Web Push é opcional. Use seu contato real para ativar as notificações.
# Formatos aceitos: mailto:voce@example.com ou https://example.com/contato
COCKPIT_CONTATO=
# Apenas o rótulo mostrado no medidor. Não muda assinatura, cobrança ou limites.
COCKPIT_PLANO=

# Arquivos e Taildrop (Tailscale é opcional para o chat).
# Vazio usa ~/taildrop-inbox; use caminho absoluto se quiser mudar.
COCKPIT_INBOX=
# COCKPIT_BIN_TAILSCALE=/usr/bin/tailscale
# COCKPIT_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# Teto por upload, em bytes. Padrão: 2 GiB.
COCKPIT_TETO_ARQUIVO=2147483648

# Opções avançadas. Normalmente não precisam mudar.
# COCKPIT_SILENCIO_UPLOAD_MS=120000
# COCKPIT_SILENCIO_MS=300000
# COCKPIT_CARENCIA_ABA_MS=30000
# COCKPIT_CERT_DIR=/caminho/certificados-legados
# COCKPIT_PUSH_DIR=/caminho/dados/push
# COCKPIT_USO_DIR=/caminho/dados/uso
# COCKPIT_STATUS_CODEX_DIR=/caminho/dados/status-codex
# COCKPIT_CLEAR_CODEX_DIR=/caminho/dados/clear-codex
# COCKPIT_CODEX_RAIZ=/caminho/codex/sessions
# Somente para fixtures de teste; em operação mantenha /proc real.
# COCKPIT_PROC_RAIZ=/proc
